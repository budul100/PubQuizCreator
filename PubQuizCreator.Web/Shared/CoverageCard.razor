@inject QuizService QuizService

<div class="card">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>
            @(Mode == CoverageMode.IdeasToQuestions ? "Question coverage" : "Slot coverage")
        </span>
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm text-secondary" />
        }
    </div>
    <div class="card-body p-2">
        @if (!isLoading && !DisplayItems.Any())
        {
            <p class="text-muted small mb-0">
                @(Mode == CoverageMode.IdeasToQuestions
                    ? "All active slots with questions covered."
                    : "No upcoming quizzes with open slots.")
            </p>
        }
        else
        {
            @foreach (var item in DisplayItems)
            {
                var color = item.Category.ColorHex;
                var textColor = color.TextColor();

                var isCovered = Mode == CoverageMode.IdeasToQuestions ? item.IsCoveredIdeas : item.IsCoveredQuestions;
                var countContent = Mode == CoverageMode.IdeasToQuestions
                ? (isCovered
                ? $"{item.IdeasAvailable}/{item.QuestionsOpen} ✓"
                : $"{item.IdeasAvailable}/{item.QuestionsOpen} (−{item.IdeasOpen})")
                : (isCovered
                ? $"{item.QuestionsAvailable}/{item.SlotsOpen} ✓"
                : $"{item.QuestionsAvailable}/{item.SlotsOpen} (−{item.QuestionsOpen})");

                var badgeStyle = isCovered
                ? $"background-color: {color}; color: {textColor}; opacity: 0.35;"
                : $"background-color: {color}; color: {textColor};";
                var badgeClass = "badge d-flex align-items-center justify-content-between gap-2 w-100";
                var countClass = !isCovered ? "fw-bold text-nowrap" : "fw-normal text-nowrap";

                <div class="mb-2">
                    @if (NavigateToQuestions)
                    {
                        <a href="/questions?categoryId=@item.Category.Id&showUsed=false"
                           class="@badgeClass text-decoration-none"
                           style="@badgeStyle cursor: pointer;">
                            <span class="text-truncate">@item.Category.Name</span>
                            <span class="@countClass" style="opacity: 1;">@countContent</span>
                        </a>
                    }
                    else if (OnCategorySelected.HasDelegate)
                    {
                        <span class="@badgeClass"
                              style="@badgeStyle cursor: pointer;"
                              @onclick="() => OnCategorySelected.InvokeAsync(item.Category.Id)">
                            <span class="text-truncate">@item.Category.Name</span>
                            <span class="@countClass" style="opacity: 1;">@countContent</span>
                        </span>
                    }
                    else
                    {
                        <span class="@badgeClass" style="@badgeStyle">
                            <span class="text-truncate">@item.Category.Name</span>
                            <span class="@countClass" style="opacity: 1;">@countContent</span>
                        </span>
                    }
                </div>
            }
        }
    </div>
</div>
